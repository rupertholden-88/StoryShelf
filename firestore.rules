rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isMember(hid) {
      return signedIn()
        && request.auth.token.email in get(/databases/$(database)/documents/households/$(hid)).data.members;
    }

    function bookFields() {
      return ['isbn', 'title', 'authors', 'illustrators', 'coverUrl', 'subjects', 'theme', 'ageBand', 'format',
              'pages', 'favourite', 'readCount', 'ratings', 'addedAt', 'addedBy', 'lookedUpAt', 'lookedUpV'];
    }

    // Older books may be missing newer fields (illustrators came later), so absent fields get defaults.
    function validBook(b) {
      return b.title is string && b.title.size() > 0 && b.title.size() <= 300
        && b.get('authors', []) is list && b.get('illustrators', []) is list && b.get('ratings', {}) is map;
    }

    // Everyone rates for themselves: a change to ratings may only touch the signed-in person's own entry.
    function ownRatingOnly() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ratings'])
        || request.resource.data.get('ratings', {}).diff(resource.data.get('ratings', {})).affectedKeys().hasOnly([request.auth.uid]);
    }

    function validHousehold(h) {
      return h.members is list && h.members.size() >= 1 && h.members.size() <= 12
        && (!('childName' in h) || (h.childName is string && h.childName.size() <= 40))
        && (!('childBirthMonth' in h) || (h.childBirthMonth is string && h.childBirthMonth.matches('^([0-9]{4}-[0-9]{2})?$')))
        && (!('giftToken' in h) || (h.giftToken is string && h.giftToken.size() >= 20 && h.giftToken.size() <= 64));
    }

    match /households/{hid} {
      // Found by the signed-in person's email: where('members', 'array-contains', email).
      allow get, list: if signedIn() && request.auth.token.email in resource.data.members;
      // Anyone signed in can start a library, with only themselves in it.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['members', 'childName', 'childBirthMonth', 'createdAt'])
        && request.resource.data.members == [request.auth.token.email]
        && validHousehold(request.resource.data);
      // Members edit the child's details, who's in it and gift-list sharing, but can't remove themselves.
      allow update: if signedIn() && request.auth.token.email in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'childName', 'childBirthMonth', 'giftToken'])
        && request.auth.token.email in request.resource.data.members
        && validHousehold(request.resource.data);
      allow delete: if false;

      match /books/{isbn} {
        allow read, delete: if isMember(hid);
        allow create: if isMember(hid)
          && request.resource.data.keys().hasOnly(bookFields())
          && request.resource.data.isbn == isbn
          && validBook(request.resource.data)
          && request.resource.data.ratings.size() == 0;
        allow update: if isMember(hid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(bookFields())
          && request.resource.data.isbn == resource.data.isbn
          && validBook(request.resource.data)
          && ownRatingOnly();
      }
      match /wishlist/{id} {
        allow read, delete: if isMember(hid);
        allow create, update: if isMember(hid)
          && request.resource.data.keys().hasOnly(['key', 'isbn', 'title', 'author', 'coverUrl', 'ageBand', 'why', 'score', 'addedAt'])
          && request.resource.data.title is string && request.resource.data.title.size() <= 300;
      }
    }
  }
}
